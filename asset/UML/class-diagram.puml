@startuml class-diagram
  package Views as Views {
    package Index as Views.Index {
      class "IndexView\n<b>Class IndexView</b>" as Views_Index_IndexView {
        +__construct()
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        -renderSuccessMessage(success)
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package SaeSujet as Views.SaeSujet {
      class "SaeSujetView\n<b>Class SaeSujetView</b>" as Views_SaeSujet_SaeSujetView {
        #templatePath()
        #templateKeys()
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package User as Views.User {
      class "RegisterSuccessView\n<b>Class RegisterSuccessView</b>" as Views_User_RegisterSuccessView {
        -user : User
        +__construct(user)
        #templatePath()
        #templateKeys()
        -getUserTypeLabel()
        -getAcademicInfo()
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
      class "LoginView\n<b>Class LoginView</b>" as Views_User_LoginView {
        +__construct()
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        #getNameCss()
        #getAdditionalHeaders()
      }
      class "RegisterView\n<b>Class RegisterView</b>" as Views_User_RegisterView {
        +__construct()
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        #getPageTitle()
        #getAdditionalScripts()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package Info as Views.Info {
      class "SiteMapView\n<b>Class SiteMapView</b>" as Views_Info_SiteMapView {
        #templatePath()
        #templateKeys()
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
      class "LegalNoticeView\n<b>Class LegalNoticeView</b>" as Views_Info_LegalNoticeView {
        #templatePath()
        #templateKeys()
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package Dashboard as Views.Dashboard {
      class "DashboardView\n<b>Class DashboardView</b>" as Views_Dashboard_DashboardView {
        +__construct(data)
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        -renderSuccessMessage()
        -getUserTypeLabel(user)
        -renderUserMetaInfo(user)
        -renderSAENavigation(user)
        -renderSAEContent(user, saes)
        -renderSAECard(user, sae)
        -renderEmptyState(user)
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package PageSAE as Views.PageSAE {
      class "PageSaeView\n<b>Class PageSaeView</b>" as Views_PageSAE_PageSaeView {
        #templatePath()
        #templateKeys()
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package pwd as Views.pwd {
      class "ResetPasswordView\n<b>Class ResetPasswordView</b>" as Views_pwd_ResetPasswordView {
        +__construct(token, email)
        #templatePath()
        #templateKeys()
        -maskEmail(email)
        -renderErrorMessages(errors)
        #getPageTitle()
        #getNameCss()
        #getAdditionalScripts()
        #getAdditionalHeaders()
      }
      class "ResetPasswordSuccessView\n<b>Class ResetPasswordSuccessView</b>" as Views_pwd_ResetPasswordSuccessView {
        #templatePath()
        #templateKeys()
        #getPageTitle()
        #getNameCss()
        #getAdditionalScripts()
        #getAdditionalHeaders()
      }
      class "ForgotPasswordView\n<b>Class ForgotPasswordView</b>" as Views_pwd_ForgotPasswordView {
        +__construct()
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        -renderSuccessMessage(success)
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
      }
    }
    package ToDoList as Views.ToDoList {
      class "ToDoListView\n<b>Class ToDoListView</b>" as Views_ToDoList_ToDoListView {
        +__construct()
        #templatePath()
        #templateKeys()
        -renderErrorMessages(errors)
        #getPageTitle()
        #getNameCss()
        #getAdditionalHeaders()
        #getAdditionalScripts()
      }
    }
  }
  package Validator as Validator {
    class "ToDoListValidator\n<b>Class LoginValidator</b>" as Validator_ToDoListValidator {
      #required : string[]
      +validate(data)
    }
    class "ForgotPasswordValidator\n<b>Class ForgotPasswordValidator</b>" as Validator_ForgotPasswordValidator {
      #required : array<string>
      +validate(data)
    }
    class "ValidationServiceRegister\n<b>Class ValidationServiceRegister</b>" as Validator_ValidationServiceRegister {
      #required : array
      +validate(data)
      -validateStudentFields(data)
    }
    class "ResetPasswordValidator\n<b>Class ResetPasswordValidator</b>" as Validator_ResetPasswordValidator {
      #required : array
      +validate(data)
    }
    class "LoginValidator\n<b>Class LoginValidator</b>" as Validator_LoginValidator {
      #required : array
      +validate(data)
    }
    class "FormValidator\n<b>Class FormValidator</b>" as Validator_FormValidator {
      #required : array
      +escape(data)
      {abstract} +validate(data)
      #isValidUserType(userType)
      #isValidEmail(email)
      #isOwnAmuEmail(email, lname, fname)
      #isValidPassword(password)
      #isValidPhone(phone)
      #isValidDate(date)
      #isValidYear(year)
      #isValidParcours(parcours)
      #isValidTD(td)
      #isValidTP(tp)
    }
  }
  package Models as Models {
    package User as Models.User {
      class "UserRepository\n<b>Class UserRepository</b>" as Models_User_UserRepository {
        -db : Database
        +__construct(db)
        +existsByEmail(email)
        +save(user)
      }
      class "Professor\n<b>Represents a professor user in the system.</b>" as Models_User_Professor {
        #amu_id : string
        +__construct(data)
        #saveSpecificData(connection, userId)
        #fetchSpecificData(db, email)
        +getAmuId()
      }
      class "Client\n<b>Represents a client user in the system.</b>" as Models_User_Client {
        #organisation : string
        +__construct(data)
        #saveSpecificData(connection, userId)
        #fetchSpecificData(db, email)
        +getOrganisation()
      }
      class "Student\n<b>Represents a student user in the system.</b>" as Models_User_Student {
        #amu_id : string
        #year : integer
        #major : string|null
        #td : string
        #tp : string
        +__construct(data)
        #saveSpecificData(connection, userId)
        #fetchSpecificData(db, email)
        +getAmuId()
        +getYear()
        +getParcours()
        +getTd()
        +getTp()
      }
      class "User\n<b>Abstract base class for all user types.</b>" as Models_User_User {
        #first_name : string
        #last_name : string
        #user_type : string
        #email : string
        #hashed_password : string
        #phone : string
        #__construct(data)
        {static} +createFromRegistrationData(data)
        {static} +createFromLoginData(data)
        +setPassword(password)
        +save()
        {abstract} #saveSpecificData(connection, userId)
        +fetchData(email)
        {abstract} #fetchSpecificData(db, email)
        {static} +existsByEmail(email)
        {static} +updatePasswordByEmail(email, newPassword)
        +getFirstName()
        +getLastName()
        +getFullName()
        +getUserType()
        +getEmail()
        +getPasswordHash()
        +getPhone()
        +isStudent()
        +isProfessor()
        +isClient()
      }
    }
    package ToDoList as Models.ToDoList {
      class "ToDoList\n<b>Class ToDoList</b>" as Models_ToDoList_ToDoList {
        -sae_group_id : integer
        -sae_subject_id : ?integer
        -todo_id : integer
        -tododesc : string
        -__construct(data)
        {static} +create(data)
        +getTodoId()
        +getTodoDesc()
        +getSaeGroupId()
        +getSaeSubjectId()
        +setSaeGroupId(sae_group_id)
        +setSaeSubjectId(sae_subject_id)
        +setTododesc(tododesc)
        +setTodoId(todo_id)
        +save()
        +fetchDataFromDatabase(sae_group_id)
        {static} +existBySaeGroupId(sae_group_id)
      }
    }
  }
  package Controllers as Controllers {
    package Index as Controllers.Index {
      class "IndexController\n<b>This class controls the Index page.</b>" as Controllers_Index_IndexController {
        +control()
        {static} +support(path, method)
      }
    }
    package PageSae as Controllers.PageSae {
      class "PageSaeController\n<b>This class controls the SAE page.</b>" as Controllers_PageSae_PageSaeController {
        +control()
        {static} +support(path, method)
      }
    }
    package SaeSujet as Controllers.SaeSujet {
      class "SaeSujetController\n<b>Controller for the form of the subject of the SAE.</b>" as Controllers_SaeSujet_SaeSujetController {
        +control()
        {static} +support(path, method)
      }
    }
    package User as Controllers.User {
      class "Logout\n<b>Logout controller.</b>" as Controllers_User_Logout {
        +control()
        {static} +support(path, method)
      }
      class "Register\n<b>This class controls the register process (get).</b>" as Controllers_User_Register {
        +control()
        {static} +support(path, method)
      }
      class "LoginPost\n<b>This class controls the login process (post).</b>" as Controllers_User_LoginPost {
        +control()
        {static} +support(path, method)
      }
      class "Login\n<b>Class Login (GET)</b>" as Controllers_User_Login {
        +control()
        {static} +support(path, method)
      }
      class "RegisterPost\n<b>This class controls the register process (post).</b>" as Controllers_User_RegisterPost {
        +control()
        {static} +support(path, method)
      }
    }
    package Info as Controllers.Info {
      class "SiteMapController\n<b>This class controls the site map page.</b>" as Controllers_Info_SiteMapController {
        +control()
        {static} +support(path, method)
      }
      class "LegalNoticeController\n<b>This class controls the legal notice page.</b>" as Controllers_Info_LegalNoticeController {
        +control()
        {static} +support(path, method)
      }
    }
    package Dashboard as Controllers.Dashboard {
      class "DashboardController\n<b>Controller responsible for handling the dashboard page.</b>" as Controllers_Dashboard_DashboardController {
        +control()
        {static} +support(path, method)
      }
    }
    package pwd as Controllers.pwd {
      class "ForgotPasswordPostController\n<b>Handles the POST request to the "/forgot-password" route.</b>" as Controllers_pwd_ForgotPasswordPostController {
        +control()
        {static} +support(path, method)
      }
      class "ForgotPasswordController\n<b>This class controls the forgot password process (get).</b>" as Controllers_pwd_ForgotPasswordController {
        +control()
        {static} +support(path, method)
      }
      class "ResetPasswordPostController" as Controllers_pwd_ResetPasswordPostController {
        +control()
        -renderFormWithToken(token, email)
        {static} +support(path, method)
      }
      class "ResetPasswordController\n<b>This class controls the reset password process (get).</b>" as Controllers_pwd_ResetPasswordController {
        +control()
        {static} +support(path, method)
      }
    }
    package ToDoList as Controllers.ToDoList {
      class "ToDoListController\n<b>Handles the control logic for the To-Do List page.</b>" as Controllers_ToDoList_ToDoListController {
        +control()
        {static} +support(path, method)
      }
      class "ToDoListPost\n<b>This class controls the todolist process (post).</b>" as Controllers_ToDoList_ToDoListPost {
        +control()
        {static} +support(path, method)
      }
    }
  }
