<?xml version="1.0"?>
<ruleset name="PHPDoc Requirements">
    <description>Vérifie la documentation PHPDoc</description>
    
    <file>App/</file>
    <file>Core/</file>
    
    <exclude-pattern>*/vendor/*</exclude-pattern>
    
    <!-- Require documentation for all classes -->
    <rule ref="PEAR.Commenting.ClassComment"/>
    
    <!-- Require documentation for all functions/methods -->
    <rule ref="PEAR.Commenting.FunctionComment">
        <exclude name="PEAR.Commenting.FunctionComment.MissingParamComment"/>
    </rule>
    
    <!-- Check inline comments -->
    <rule ref="Squiz.Commenting.InlineComment"/>
    
    <!-- Require @param, @return, @throws tags -->
    <rule ref="Squiz.Commenting.FunctionComment"/>
    <rule ref="Squiz.Commenting.FunctionCommentThrowTag"/>
    
    <!-- Require documentation for variables -->
    <rule ref="Squiz.Commenting.VariableComment"/>
</ruleset>
