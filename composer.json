{
  "name": "saemanager/app",
  "description": "SAE Manager Application",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "erusev/parsedown": "^1.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10",
    "phpmd/phpmd": "^2.15",
    "friendsofphp/php-cs-fixer": "^3.14",
    "phpdocumentor/phpdocumentor": "^3.3",
    "smeghead/php-class-diagram": "^1.6",
    "jawira/plantuml": "^1.2025",
    "pdepend/pdepend": "^2.16",
    "qossmic/deptrac": "^2.0",
    "phpmetrics/phpmetrics": "^2.9",
    "vimeo/psalm": "^6.14"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "Core/",
      "Utilis\\": "Core/Utilis/",
      "Controllers\\": "App/src/Controllers/",
      "Models\\": "App/src/Models/",
      "Views\\": "App/src/Views/",
      "Validator\\": "App/src/Validator/",
      "App\\": "App/src/",
      "public\\": "public/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "App/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "phpcs": "phpcs --standard=PSR12 App/src/",
    "phpcbf": "phpcbf --standard=PSR12 App/src/",
    "phpstan": "phpstan analyse App/src/ Core/ --level=8",
    "phpdoc": [
      "vendor/bin/phpdoc run --directory=App/src --target=docs/api --ignore='vendor/*,tests/*' --title='SAE Manager API Documentation' --template=default --force"
    ],
    "quality": [
      "@phpcs",
      "@phpstan",
      "@test"
    ],
    "fix": "phpcbf --standard=PSR12 App/src/"
  },
  "config": {
    "allow-plugins": {
      "phpdocumentor/graphviz": true,
      "phpdocumentor/type-resolver": true
    }
  }
}
